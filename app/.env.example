# Browser-safe Supabase Auth configuration (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Server-side Next.js API proxy target; never prefix this with NEXT_PUBLIC_
ISYEN_API_BASE_URL=https://isyen-api.vercel.app
