# API host environment
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Exact HTTPS origin of web/ (no trailing slash). Comma-separate multiple origins if needed.
ALLOWED_ORIGINS=https://your-web-domain.example
PORT=3001

# Never use SUPABASE_SERVICE_ROLE_KEY; the API forwards the user's JWT and relies on RLS.
