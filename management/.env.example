# Supabase project URL and public anon/publishable key only. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# API origin, without a trailing slash. The app requests /v1/admin/overview.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
