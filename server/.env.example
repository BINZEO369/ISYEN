# ISYEN backend runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Supabase project settings for authenticated, RLS-protected REST requests.
SUPABASE_URL=https://fabasazefdnkpygglajz.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-publishable-or-anon-key

# Optional; current public REST routes do not use this key.
# Keep it only in server runtime secrets if a privileged backend job is added.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
