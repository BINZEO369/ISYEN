# ISYEN backend runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Supabase public project settings used by the user-scoped API client.
SUPABASE_URL=https://fabasazefdnkpygglajz.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-publishable-or-anon-key

# Server-only key. Never expose this to app/management or commit it to Git.
# Required for /ready and resolving auth_user_id -> user_profiles.isyen_id.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
