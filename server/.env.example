# ISYEN backend runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Supabase project settings for authenticated, RLS-protected REST requests.
SUPABASE_URL=https://fabasazefdnkpygglajz.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-publishable-or-anon-key

# Required for server-only auth signup + user_profiles insert; never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
