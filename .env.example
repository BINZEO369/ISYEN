# Next.js build-time public variables — anon key and API URL are browser-visible
NEXT_PUBLIC_SUPABASE_URL=https://fabasazefdnkpygglajz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Separate Node.js API host environment
SUPABASE_URL=https://fabasazefdnkpygglajz.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app,https://your-custom-domain.example
PORT=3001

# Never configure SUPABASE_SERVICE_ROLE_KEY; API uses user JWT + RLS.
