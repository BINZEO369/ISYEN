# API host environment (Node/Vercel/Render/Railway)
SUPABASE_URL=https://fabasazefdnkpygglajz.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.example
PORT=3000

# Frontend/Vercel configuration endpoint; public URL only, no secrets.
# Set this to the deployed API origin when frontend and API use different hosts.
PUBLIC_API_BASE_URL=https://your-api-host.example

# Do not set or expose SUPABASE_SERVICE_ROLE_KEY for this app.
# The API passes through each user's access token and lets Supabase RLS enforce ownership.
